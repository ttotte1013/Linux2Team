// F_quizmain.html은 예시 데이터로 입력한 상태 -> 실제 데이터를 입력받고 나서 해당 내용을 F_quizmain.html 파일의 <script>부분에 덮어쓰기하기

<script>
    let isAnswered = false;
    let currentQuizData = null; // 퀴즈 응답 여부 확인 및 서버 데이터 저장 변수

    // 1. 백엔드 서버에서 데이터를 실시간으로 가져오는 함수
    function fetchQuizFromServer() {
        // 서버 API 엔드포인트 설정
        const apiUrl = "http://localhost:8080/api/quiz/random?category=eng_ko";

        fetch(apiUrl)
            .then(response => { // 응답 상태 확인
                if (!response.ok) {
                    throw new Error("네트워크 응답에 문제가 발생했습니다.");
                }
                return response.json(); // 받아온 텍스트를 JSON 오브젝트로 변환
            })
            .then(data => {
                currentQuizData = data; // 서버 데이터를 전역 변수에 저장
                loadQuiz(currentQuizData); // 화면에 데이터 바인딩
            })
            .catch(error => { // 에러 발생 시 처리
                console.error("데이터를 가져오는 중 오류 발생:", error);
                document.getElementById("question").innerText = "데이터 로드 실패";
            });
    }

    // 2. 가져온 데이터를 화면에 입력하는 함수
    function loadQuiz(data) {
        isAnswered = false;
        document.getElementById("explanation").style.display = "none"; // 해설 박스 초기화

        // 퀴즈 진행 상태 표시 (01/10 형식)
        document.getElementById("progress").innerText = `QUIZ ${String(data.current_num).padStart(2, '0')} / ${data.total_num}`;
        document.getElementById("question").innerText = data.question;
        
        const optionsGroup = document.getElementById("options");
        optionsGroup.innerHTML = ""; // 기존 버튼 초기화

        // 선택지 버튼 생성 로직
        data.options.forEach((optionText, index) => {
            const button = document.createElement("button");
            button.className = "btn-option";
            button.innerText = `${index + 1}. ${optionText}`;

            // 버튼 클릭 시 정답 여부 판별 함수 호출
            button.onclick = () => {
                if (!isAnswered) {
                    handleOptionClick(index + 1, data);
                }
            };

            optionsGroup.appendChild(button);
        });
    }

    // 3. 정답 및 오답 판별 후 해설 출력 로직
    function handleOptionClick(selectedIndex, data) {
        isAnswered = true;
        const expBox = document.getElementById("explanation");
        const expTitle = document.getElementById("exp-title");
        const expText = document.getElementById("exp-text");
        const expExample = document.getElementById("exp-example");

        const correctAnswerText = `${data.answer}. ${data.options[data.answer - 1]}`;

        // 선택값과 정답 데이터 비교
        if (selectedIndex === data.answer) {
            expTitle.className = "explanation-title status-correct";
            expTitle.innerText = "정답입니다!";
        } else {
            expTitle.className = "explanation-title status-wrong";
            expTitle.innerText = "틀렸습니다.";
        }

        // 해설 및 예문 정보 바인딩
        expText.innerHTML = `정답: <strong>${correctAnswerText}</strong>`;
        expExample.innerHTML = `<strong>💡 예문 공부하기</strong><br>${data.example}<br><span style="font-size: 13px; color: #7a8b83;">${data.example_ko}</span>`;

        // 해설 박스 노출
        expBox.style.display = "block";
    }

    // 4. 페이지가 로드 완료 시 서버 통신 시작
    window.onload = function() {
        fetchQuizFromServer();
    };
</script>
